{
  "name": "@intentgate/basic-auth-protocol",
  "version": "0.3.0",
  "description": "Wire format, canonical JSON and challenge derivation for Intentgate basic-auth (site check-in) events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Intentgate-id/SDK_kit.git", "directory": "web/packages/protocol" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
